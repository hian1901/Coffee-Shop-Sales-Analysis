	measure 'label for store location' = SELECTEDVALUE('real_pj_coffee_shop_db sales_db_copy'[store_location]) & " | " & [Total sale]
		lineageTag: 9d85aac3-229f-4456-b826-cfc6ba83a1f1

	measure 'Daily Avg' = AVERAGEX(ALLSELECTED('real_pj_coffee_shop_db sales_db_copy'[transaction_date]),[Total sale])
		lineageTag: 89f0a9c8-802f-43b7-8172-d6381c9cbb21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Color for bar' = if([Total sale]>[Daily Avg],"above","below")
		lineageTag: 21f2c7ea-f5fa-42ef-acd0-b162b54c471d

	measure 'label for product category' = SELECTEDVALUE('real_pj_coffee_shop_db sales_db_copy'[product_category]) & " | " & [Total sale]
		lineageTag: 0466354a-c5e2-4b0d-b6c8-83435d396a64

	measure 'Product label' = ```
			
			VAR month_diff = [CM_sales] - [PM_sales]
			VAR MoM =( [CM_sales] - [PM_sales] ) / [PM_sales]
			VAR _sign = IF(month_diff > 0,"+","")
			VAR _signtrend = IF(month_diff > 0,"▲","▼") 
			RETURN
			_signtrend & "" & _sign & format(MoM,"#0.0%") 
			```
		lineageTag: 277feadc-74e5-45fb-9205-8e8db17b0c11

	measure 'label for product type' = SELECTEDVALUE('real_pj_coffee_shop_db sales_db_copy'[product_type]) & " | " & [Total sale]
		lineageTag: 8f0ba16b-f027-400f-a317-fc57dfb51cb0

	measure 'TT hour' = "Hour no" & ":" & " " & FORMAT(AVERAGE('real_pj_coffee_shop_db sales_db_copy'[Hour]),0)

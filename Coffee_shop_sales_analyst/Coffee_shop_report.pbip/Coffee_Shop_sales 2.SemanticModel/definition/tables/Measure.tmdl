table Measure
	lineageTag: 12fc3ced-70a1-427d-b89b-5b132c913bd6

	measure CM_sales =
			VAR selected_month = SELECTEDVALUE(Date_table[Month])
			return
			TotalMTD(calculate(sum('real_pj_coffee_shop_db sales_db_copy'[revenue]), Date_table[Month] = selected_month), Date_table[Date])
		lineageTag: 09dc7fdf-2dc9-4f12-81fe-a09690cc6d65

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PM_sales = CALCULATE([CM_sales],DATEADD(Date_table[Date],-1,MONTH))
		lineageTag: 26af33e2-3c63-4bc4-b538-ecadacb2e8da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM & sales_diff' = ```
			
			VAR month_diff = [CM_sales] - [PM_sales]
			VAR MoM =( [CM_sales] - [PM_sales] ) / [PM_sales]
			VAR _sign = IF(month_diff > 0,"+","")
			VAR _signtrend = IF(month_diff > 0,"▲","▼") 
			RETURN
			_signtrend & "" & _sign & format(MoM,"#0.0%") & "|" & _sign  &FORMAT(month_diff/1000,"#0.0K") & "" & " vs LM"
			```
		lineageTag: 69ec4c78-90d6-47e4-8d13-120ca44c0140

	measure total_orders = DISTINCTCOUNT('real_pj_coffee_shop_db sales_db_copy'[transaction_id])
		formatString: 0
		lineageTag: ffd11847-ca28-48f9-bcf7-d9b48fa2683f

	measure CM_Orders =
			VAR selected_month = SELECTEDVALUE(Date_table[Month])
			return
			TotalMTD(calculate(DISTINCTCOUNT('real_pj_coffee_shop_db sales_db_copy'[transaction_id]), Date_table[Month] = selected_month), Date_table[Date])
		formatString: 0
		lineageTag: d0338337-1667-42fd-937f-dae6b84c155c

	measure PM_orders = CALCULATE([CM_Orders],DATEADD(Date_table[Date],-1,MONTH))
		formatString: 0
		lineageTag: 216ca58a-8ca5-49ba-a117-417bac86b45b

	measure 'MoM & order_diff' = ```
			
			VAR month_diff = [CM_Orders] - [PM_orders]
			VAR MoM =( [CM_Orders] - [PM_orders] ) / [PM_orders]
			VAR _sign = IF(month_diff > 0,"+","")
			VAR _signtrend = IF(month_diff > 0,"▲","▼") 
			RETURN
			_signtrend & "" & _sign & format(MoM,"#0.0%") & "|" & _sign  & month_diff & "" & " vs LM"
			```
		lineageTag: fbbd743b-b1e6-40b1-8255-eee534cf7fc3

	measure CM_Qty = ```
			VAR selected_month = SELECTEDVALUE(Date_table[Month])
			return
			TotalMTD(calculate(SUM('real_pj_coffee_shop_db sales_db_copy'[transaction_qty]), Date_table[Month] = selected_month), Date_table[Date]) 
			```
		formatString: 0
		lineageTag: 6b9fe477-6799-4458-a1f9-548caa18da6e

	measure PM_Qty = CALCULATE([CM_Qty],DATEADD(Date_table[Date],-1,MONTH))
		formatString: 0
		lineageTag: 8eacedd9-5c33-43ae-b50b-261c387640b9

	measure 'MoM & QTy_diff' = ```
			
			VAR month_diff = [CM_Qty] - [PM_Qty]
			VAR MoM =( [CM_Qty] - [PM_Qty] ) / [PM_Qty]
			VAR _sign = IF(month_diff > 0,"+","")
			VAR _signtrend = IF(month_diff > 0,"▲","▼") 
			RETURN
			_signtrend & "" & _sign & format(MoM,"#0.0%") & "|" & _sign  & month_diff & "" & " vs LM"
			```
		lineageTag: 57dad860-befc-47f3-9105-f971fc418990

	measure total_Qty = SUM('real_pj_coffee_shop_db sales_db_copy'[transaction_qty])
